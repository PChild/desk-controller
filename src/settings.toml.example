CIRCUITPY_WIFI_SSID="your_wifi_name"
CIRCUITPY_WIFI_PASSWORD="your_wifi_password"
CIRCUITPY_HOSTNAME="desk"
CIRCUITPY_WIFI_HOSTNAME="desk"
CIRCUITPY_WEB_API_PASSWORD="replace-with-a-unique-random-password"
CIRCUITPY_WEB_API_PORT=8080
CIRCUITPY_WEB_INSTANCE_NAME="Desk Controller"
LED_STARTUP_SECONDS=30
LED_STATUS_SECONDS=10
HTTP_DEBUG=false

# Computer to wake when the AtomS3 Lite center button is pressed.
WOL_MAC_ADDRESS="AA:BB:CC:DD:EE:FF"
WOL_BROADCAST_ADDRESS="255.255.255.255"
WOL_PORT=9

# Windows computer running tools/movie_mode_agent.ps1.
MOVIE_MODE_HOST="192.168.1.151"
MOVIE_MODE_PORT=8765
MOVIE_MODE_TOKEN="replace-with-a-long-random-value"
