@{
    # Windows display names to cover. Find these in Windows display settings
    # or with [Windows.Forms.Screen]::AllScreens after loading WinForms.
    BlackoutDisplays = @(
        "\\.\DISPLAY1"
        "\\.\DISPLAY2"
    )

    ListenPort = 8765
    ControllerOffUrl = "http://desk.local/api/movie/off"

    # Use the same private value for MOVIE_MODE_TOKEN in settings.toml.
    Token = "replace-with-a-long-random-value"
}
